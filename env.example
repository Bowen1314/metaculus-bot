# Copy to `.env` (same directory), fill in, then: chmod 600 .env
# The bot reads secrets ONLY from that file. Anything in the shell / system environment is
# ignored and removed from the process, and names not listed here are ignored too.

# Required. Metaculus > Settings > My Forecasting Bots > your bot > "Show token".
METACULUS_TOKEN=REPLACE_ME

# Required to forecast. The donated LLM credits arrive as an OpenRouter key.
OPENROUTER_API_KEY=REPLACE_ME

# Optional: AskNews (free for tournament participants, by email request). Use either the
# client id + secret pair or the single API key, whichever AskNews gives you.
# ASKNEWS_CLIENT_ID=
# ASKNEWS_SECRET=
# ASKNEWS_API_KEY=

# Optional, only if config.toml is changed to call a provider directly instead of OpenRouter.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
